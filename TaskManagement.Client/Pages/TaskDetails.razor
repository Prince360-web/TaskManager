@page "/tasks/{Id:int}"
@using TaskManagement.Client.Models
@using Microsoft.AspNetCore.Authorization
@using TaskManagement.Client.Services
@inject TaskService TaskService
@inject NavigationManager NavigationManager
@attribute [Authorize]

<div class="mb-3">
    <a href="/tasks" class="btn btn-sm btn-link">&lt; Back to Task List</a>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (task == null)
{
    <div class="alert alert-danger">
        Task not found or access denied.
    </div>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3>@task.Title</h3>
            <span class="badge @GetStatusBadgeClass()">@task.Status</span>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <p><strong>Assigned To:</strong> @(string.IsNullOrEmpty(task.AssignedToUserName) ? "Unassigned" : task.AssignedToUserName)</p>
                    <p><strong>Due Date:</strong> @task.DueDate.ToShortDateString()</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Created Date:</strong> @task.CreatedDate.ToShortDateString()</p>
                    <p><strong>Status:</strong> @task.Status</p>
                </div>
            </div>

            <h5>Description</h5>
            <div class="p-3 bg-light rounded">
                <p>@task.Description</p>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-end">
                <button class="btn btn-warning me-2" @onclick="EditTask">Edit</button>
                <button class="btn btn-danger" @onclick="() => showDeleteConfirmation = true">Delete</button>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirmation)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeleteConfirmation = false"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this task?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => showDeleteConfirmation = false">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteTask">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool loading = true;
    private TaskItem task;
    private bool showDeleteConfirmation = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTaskAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadTaskAsync();
    }

    private async Task LoadTaskAsync()
    {
        try
        {
            loading = true;
            task = await TaskService.GetTaskByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading task: {ex.Message}");
            task = null;
        }
        finally
        {
            loading = false;
        }
    }

    private void EditTask()
    {
        NavigationManager.NavigateTo($"/tasks/edit/{Id}");
    }

    private async Task DeleteTask()
    {
        try
        {
            var result = await TaskService.DeleteTaskAsync(Id);
            if (result)
            {
                NavigationManager.NavigateTo("/tasks");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting task: {ex.Message}");
        }
        finally
        {
            showDeleteConfirmation = false;
        }
    }

    private string GetStatusBadgeClass()
    {
        return task?.Status switch
        {
            Models.TaskStatus.Pending => "bg-secondary",
            Models.TaskStatus.InProgress => "bg-primary",
            Models.TaskStatus.Completed => "bg-success",
            _ => "bg-secondary"
        };
    }
}
