@using Microsoft.AspNetCore.Components.Authorization
@using TaskManagement.Client.Shared
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly" PreferExactMatches="@true">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (!context.User.Identity.IsAuthenticated)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <p class="alert alert-danger">You are not authorized to access this resource.</p>
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="loading-message">
                        <p>Determining your permissions...</p>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="not-found">
                    <h1>Page not found</h1>
                    <p>Sorry, there's nothing at this address.</p>
                    <NavLink href="/" class="btn btn-primary">Return to Home</NavLink>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private class RedirectToLogin : ComponentBase
    {
        [Inject] NavigationManager Navigation { get; set; }
        
        protected override void OnInitialized()
        {
            Navigation.NavigateTo("/login");
        }
    }
}

